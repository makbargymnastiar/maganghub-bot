[Unit]
Description=Bot pengingat absensi monev Maganghub
Documentation=file:///opt/monev-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monevbot
Group=monevbot
WorkingDirectory=/opt/monev-bot
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Jakarta
ExecStart=/opt/monev-bot/.venv/bin/python run.py
Restart=always
RestartSec=15

# Hardening: bot hanya butuh tulis di data/ (SQLite); log masuk ke journald
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/monev-bot/data

# SIGTERM disambut stop event di run.py; 20 detik cukup untuk menutup koneksi
TimeoutStopSec=20
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=monev-bot

[Install]
WantedBy=multi-user.target
